# Copy to .env.local for local development, and add the same keys in your hosting settings.
# Never commit real values.

# ---------- Database ----------
# Local (dev): the Postgres in Docker (npm run db:up, then npm run db:fresh). Keep the real (Neon) one out of
#              .env.local: only the hosting settings need it.
# Neon:        postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Tests:       pglite:./.data/pglite   (built-in database, no Docker needed)
DATABASE_URL=postgresql://annapurna:annapurna_local@localhost:5432/annapurna
# Local only: the super admin's password after npm run db:fresh (default testpass123)
# LOCAL_SUPER_ADMIN_PASSWORD=

# Dashboard sign-in sessions. Random 32+ characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Printout (customers' documents) ----------
# Vercel → project → Storage → Create → Blob (choose Private) → connect to the project.
# Vercel adds BLOB_STORE_ID and signs in with OIDC; nothing else is needed there.
# On your computer (no OIDC), files are kept in .data/uploads instead.
BLOB_STORE_ID=
# Only for stores used outside Vercel: a read-write token instead of OIDC
# BLOB_READ_WRITE_TOKEN=
# Only if the Blob store was created as Public (Private is recommended)
# BLOB_ACCESS=public
# Optional: protects the daily clean-up job (/api/cron/print-cleanup). Any random string.
CRON_SECRET=
# Optional: the site's address, used in the counter QR code (default https://annapurna-online.vercel.app)
# SITE_URL=https://annapurna-online.vercel.app

# ---------- WhatsApp Cloud API ----------
# Meta for Developers → your App → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta for Developers → your App → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta's webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
# Optional
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_UNAVAILABLE=booking_unavailable
# 1 = print outgoing WhatsApp messages in the terminal instead of sending them
WHATSAPP_DRY_RUN=0

# ---------- Annapurna Assist (AI assistant) ----------
# Google AI Studio (aistudio.google.com) → Get API key. Free tier: no card needed.
# Server only: never put it in a NEXT_PUBLIC_ variable, or the browser could read it.
GOOGLE_API_KEY=
# Optional: which Gemini model answers (default gemini-3.5-flash-lite, 500 a day). gemini-3.8-flash is smarter, 20 a day.
# ASSISTANT_MODEL=gemini-3.8-flash
